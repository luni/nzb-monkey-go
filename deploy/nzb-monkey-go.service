# nzb-monkey-go web service unit
#
# Deploy to /etc/systemd/system/nzb-monkey-go.service (system service) or
# ~/.config/systemd/user/nzb-monkey-go.service (user service), adjust the
# values marked with <...> to your site, then run:
#   systemctl daemon-reload && systemctl enable --now nzb-monkey-go
#
# The service MUST run in the same network namespace as SABnzbd so it can
# reach the SABnzbd API and so that usenet traffic takes the same route.

[Unit]
Description=nzb-monkey-go NZBLNK web service
After=network-online.target <netns-provider>.service
Wants=network-online.target
# die together with the namespace so the service never ends up on the
# wrong network stack after a namespace restart
BindsTo=<netns-provider>.service

[Service]
Type=simple
# create the state dir writable by the service user
ExecStartPre=/usr/bin/install -d -o sabnzbd /var/lib/nzb-monkey-go
#
# Join the SABnzbd network namespace. Pick ONE of these mechanisms:
#
# a) named netns (iproute2), same mechanism SABnzbd uses - also picks up
#    /etc/netns/<name>/resolv.conf for in-namespace DNS:
ExecStart=/sbin/ip netns exec <netns-name> /usr/bin/sudo -u sabnzbd /usr/local/bin/nzb-monkey-go --serve --config /etc/nzb-monkey-go/config
#
# b) systemd 256+: NetworkNamespacePath enters the namespace natively and
#    allows User= directly. NOTE: it does NOT apply the per-netns
#    resolv.conf from /etc/netns/, so DNS inside the namespace must be
#    configured separately (e.g. a resolv.conf bind mount).
# User=sabnzbd
# NetworkNamespacePath=/run/netns/<netns-name>
# ExecStart=/usr/local/bin/nzb-monkey-go --serve --config /etc/nzb-monkey-go/config
#
# If SABnzbd does not run in a dedicated network namespace, remove the
# namespace lines above and the BindsTo/After placeholders in [Unit].
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
